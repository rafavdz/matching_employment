  author = {Dark, Shawna J. and Bram, Danielle},
  date = {2007-10-01},
  journaltitle = {Progress in Physical Geography: Earth and Environment},
  shortjournal = {Progress in Physical Geography: Earth and Environment},
  volume = {31},
  number = {5},
  pages = {471--479},
  publisher = {SAGE Publications Ltd},
  issn = {0309-1333},
  doi = {10.1177/0309133307083294},
  url = {https://doi.org/10.1177/0309133307083294},
  urldate = {2022-05-13},
  abstract = {Of particular importance to the study of large-scale phenomena in physical geography is the modifiable areal unit problem (MAUP). While often viewed as only a problem in human geography (particularly demographic studies), the MAUP is an issue for all quantitative studies in geography of spatial phenomena (Openshaw and Taylor, 1979). Increasingly, remote sensing and Geographic Information Systems (GIS) are being used to assess the distribution of phenomena from a large scale. These phenomena are modelled using areal units that can take any shape or size resulting in complications with statistical analysis related to both the scale and method used to create the areal units. In this paper, we define the modifiable areal unit problem, present examples of when it is a problem in physical geography studies, and review some potential solutions to the problem. Our aim is to increase awareness of this complicated issue and to promote further discussion and interest in this topic.},
  issue = {5},
  langid = {english},
  keywords = {aggregation,GIS,hydrological modelling,modifiable areal unit problem (MAUP),scale},
  file = {/Users/rafa/Library/CloudStorage/OneDrive-UniversityofGlasgow/ZotFiles/Dark_Bram_2007_The modifiable areal unit problem (MAUP) in physical geography.pdf}
}

