@article{Frost1995,
  title = {The Rediscovery of Accessibility and Economic Potential: The Critical Issue of Self-Potential},
  author = {Frost, M. E. and Spence, N. A.},
  date = {1995},
  journaltitle = {Environment \& Planning A},
  volume = {27},
  number = {11},
  pages = {1833--1848},
  doi = {10.1068/a271833},
  abstract = {Economic potential measures of accessibility seem to have been rediscovered in European research literature recently, as well as in research that informs policy formulation. These new applications are using more and more sophisticated sources of data but are in large measure still operationalising the familiar concepts of market potential. Such potential is calculated for any zone by summing the representative economic mass of all other zones in the system each divided by some measure of the intervening travel impedance between that zone and every other zone. In this straightforward calculation it becomes necessary to incorporate the economic mass of the zone under consideration itself and to decide on the appropriate travel impedance. This apparently simple task is the focus of this paper. Most research of this type uses a weighting of the radius of the circle equalling the area of the zone in question to approximate the travel impedance. The purpose of this paper is to demonstrate that the choice of weighting is important in determining the nature of the resultant potential surface. -Authors},
  issue = {11},
  file = {/Users/rafa/Library/CloudStorage/OneDrive-UniversityofGlasgow/ZotFiles/Frost_Spence_1995_The rediscovery of accessibility and economic potential.pdf}
}

@article{Saporito2007,
  title = {From Here to There: {{Methods}} of Allocating Data between Census Geography and Socially Meaningful Areas},
  author = {Saporito, Salvatore and Chavers, Jana M and Nixon, Laura C and McQuiddy, Megan R},
  date = {2007},
  journaltitle = {Social Science Research},
  volume = {36},
  number = {3},
  pages = {897--920},
  doi = {10.1016/j.ssresearch.2006.05.004},
  url = {https://www.sciencedirect.com/science/article/pii/S0049089X0600069X},
  abstract = {Sociologists often need to reassign data from one set of geographic areas (called source units) to another set of geographic areas (called target units) in cases where the two zonal systems are spatially incongruent. Although geographers have developed a variety of interpolation techniques to address the challenge of reallocating data across misaligned geography, there has been limited use of these methods in sociological research. As a result of the scant use of interpolation methods by researchers, the accuracy of these methods has not been assessed adequately with empirical data typically encountered by sociologists. To address this shortcoming, the authors describe four ways of reassigning data across incompatible zonal systems and test the accuracy of each approach with two case studies. The first example reassigns racial data from block groups to school attendance boundaries for selected school systems and the second reassigns racial data from school districts to Public Use Micro Areas for the entire US.},
  issue = {3},
  keywords = {Areal interpolation,Census data,Misaligned geography,Segregation},
  file = {/Users/rafa/Library/CloudStorage/OneDrive-UniversityofGlasgow/ZotFiles/Saporito et al_2007_From here to there.pdf}
}

@article{Levinson2020,
  title = {Towards a General Theory of Access},
  author = {Levinson, David M and Wu, Hao},
  date = {2020},
  journaltitle = {Journal of Transport and Land Use},
  volume = {13},
  number = {1},
  pages = {129--158},
  doi = {10.5198/jtlu.2020.1660},
  abstract = {This paper integrates and extends many of the concepts of accessibility deriving from Hansen’s (1959) seminal paper, and develops a theory of access that generalizes from the particular measures of access that have become increasingly common. Access is now measured for a particular place by a particular mode for a particular purpose at a particular time in a particular year. General access is derived as a theoretical ideal that would be measured for all places, all modes, all purposes, at all times, over the lifecycle of a project. It is posited that more general access measures better explain spatial location phenomena.},
  issue = {1},
  file = {/Users/rafa/Library/CloudStorage/OneDrive-UniversityofGlasgow/ZotFiles/Levinson_Wu_2020_Towards a general theory of access.pdf}
}

@article{Ahlfeldt2013,
  title = {If We Build It, Will They Pay? Predicting Property Price Effects of Transport Innovations},
  author = {Ahlfeldt, Gabriel M},
  date = {2013},
  journaltitle = {Environment and Planning A},
  volume = {45},
  number = {8},
  pages = {1977--1994},
  doi = {10.1068/a4549},
  abstract = {In this study I apply a gravity-type labor-market accessibility model to the Greater London Area to investigate house price capitalization effects. The spatial scope of labor-market effects is found to be about 60 minutes. Doubling accessibility increases the utility of an average household by about 12\%. I combine the gravity approach with a transport decision model that takes into account the urban rail network architecture, allows for mode switching, and thus accounts for the effective accessibility offered by a station, to predict the property price effects of the 1999 Jubilee Line and DLR extension. A considerable degree of heterogeneity is predicted both in terms of the magnitude as well as the spatial extent of price effects around new stations. A quasi-experimental property price analysis reveals that the model performs well in predicting the effective capitalization effects, suggesting that the approach might be a viable ingredient in transport planning. © Pion and its licensors.},
  issue = {8},
  keywords = {Gravity equation,Hedonic analysis,Property prices,Transport innovations},
  file = {/Users/rafa/Library/CloudStorage/OneDrive-UniversityofGlasgow/ZotFiles/Ahlfeldt_2013_If we build it, will they pay.pdf}
}

@article{Thorsen1998,
  title = {Empirical Evaluation of Alternative Model Specifications to Predict Commuting Flows},
  author = {Thorsen, Inge and Gitlesen, Jens Petter},
  date = {1998},
  journaltitle = {Journal of Regional Science},
  volume = {38},
